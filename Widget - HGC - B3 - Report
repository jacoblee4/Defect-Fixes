// Server Script

(function () {
	var b3_utils = new HGC_B3_Utils();
	
	if (input == undefined) {  // On load
		data.fieldUserQuery = "active=true";
		
		data.from = "";
		data.to = "";
		
		data.eventManager = gs.hasRole("x_banun_b3.event_manager");
		data.delegatedAccess = b3_utils.getDelegatedUsers(gs.getUserID());
		data.delegatedToMe = data.delegatedAccess.length != 0;
		
		// Set default Selection choice to 'Me'
		data.selectionChoice = 'me';
		
		// Populate selection choices depending on if the current user has delegated users and/or is a manager
		data.selectionItems = [{
			choiceDisplay: 'Me',
			choiceValue: 'me'
		}];
		if (data.delegatedToMe)
			data.selectionItems.push({
				choiceDisplay: 'Users delegated to me',
				choiceValue: 'delegated_users'
			});
		if (data.eventManager)
			data.selectionItems.push({
				choiceDisplay: 'All users',
				choiceValue: 'users'
			});
		
	} else if (input.action == 'filterEvents') {  // on Submit
		updateResults();
		data.submitted = true;
	}
	
	function updateResults() {
		// Initiate vars
		data.events = [];
		data.event_ids = [];
		data.sumEvents = 0;
		data.sumHours = 0;
		
		// Filter
		data.userSelected = input.userSelected || { value: "", displayValue: ""};
		
		var userQuery = null;
		if (input.selectionChoice == 'me') {
			userQuery = gs.getUserID();
		} else {
			// If a specific user was selected
			if (data.userSelected.value != "") {
				userQuery = data.userSelected.value;
			} else {
				if (input.selectionChoice == 'delegated_users') {
					userQuery = input.delegatedAccess.toString();
				}
			}
		}
		
		// Date range		
		var fromQuery = input.from != "" ? ">=javascript:gs.dateGenerate('" + input.from + "','00:00:00')" : null;
		var toQuery = input.to != "" ? "<=javascript:gs.dateGenerate('" + input.to + "','23:59:59')" : null;
		
		// Get events
		var event_array = getEvents(userQuery, fromQuery, toQuery);
		var event_index = 0;
		var event_len = event_array.length;

		// Get IVAs
		var iva_array = getIVAs(userQuery, fromQuery, toQuery);
		var iva_index = 0;
		var iva_len = iva_array.length;

		// Sort by date
		while (data.events.length != event_len + iva_len){
			// Events are all in the final object
			if (event_index == event_len){
				for (var i=iva_index; i<iva_len; i++){
					data.events.push(iva_array[i]);
					data.event_ids.push(iva_array[i].sys_id);
					data.sumHours += +iva_array[i].hours;
					data.sumEvents++;
				}
			}
			// IVAs are all in the final object
			else if (iva_index == iva_len){
				for (var j=event_index; j<event_len; j++){
					data.events.push(event_array[j]);
					data.event_ids.push(event_array[j].sys_id);
					data.sumHours += +event_array[j].hours;
					data.sumEvents++;
				}
			}

			// Not finished sorting
			else{
				// Call sorting helper (iva greater)
				if (event_greater(event_array[event_index].date, iva_array[iva_index].date)){
					data.events.push(iva_array[iva_index]);
					data.event_ids.push(iva_array[iva_index].sys_id);
					data.sumHours += +iva_array[iva_index].hours;
					iva_index++;
					data.sumEvents++;
				}

				// Event greater
				else{
					data.events.push(event_array[event_index]);
					data.event_ids.push(event_array[event_index].sys_id);
					data.sumHours += +event_array[event_index].hours;
					event_index++;
					data.sumEvents++;
				}
			}
		}
	}

	function getEvents(userQuery, fromQuery, toQuery){

		// get the scheduled events
		var registration = new GlideRecord('x_banun_b3_m2m_users_events');
		
		if (userQuery)
			registration.addQuery('user', 'IN', userQuery);
		if (fromQuery)
			registration.addEncodedQuery('b3_event.start_time' + fromQuery);
		if (toQuery)
			registration.addEncodedQuery('b3_event.end_time' + toQuery);
		
		registration.addQuery('state', 'accepted');
		registration.orderByDesc('b3_event.start_time');
		registration.addEncodedQuery('b3_event.end_timeRELATIVELT@hour@ago@1');

		// Save for PDF export
		data.eventsQuery = registration.getEncodedQuery();
		
		registration.query();
		
		var event_array = [];

		while (registration.next()) {
			var event = registration.b3_event.getRefRecord();
			var location_dv = [];
			var logo_url = '';
			var guidestar_org = "";
			if (event.getValue('guidestar_organization_payload')) {								
				try {
					guidestar_org = JSON.parse(event.getValue('guidestar_organization_payload'));
				} catch(ex) {
					var linkToRecord = '<a href="x_banun_b3_m2m_users_events.do?sys_id=' + registration.sys_id + '" class="breadcrumb" target="_blank">' + registration.b3_event.getDisplayValue() + '</a> ';
					gs.addErrorMessage(linkToRecord + " record has been skipped due to a Jason parsing error. Verify that the 'guidestar_organization_payload' field of this record contains valid Json Syntax");
				}				
				if (guidestar_org.logo_url) {
					logo_url = guidestar_org.logo_url;
				}
			}
			var county = ""; var msa = ""; var csa = "";
			if (event.getValue('b3_county')) {
				county = event.b3_county.getRefRecord();
				if (county.msa) {
					msa = county.getDisplayValue('msa');
					if (county.msa.csa)
						csa = county.msa.getDisplayValue('csa');
				}
			}
			
			event_array.push({
				sys_id: event.getUniqueValue(),
				title: event.getValue('title'),
				date: event.getDisplayValue('start_time').split(" ")[0],  //get Date w/out time
				first_name: getUserRec(registration.getValue('user')).getValue('first_name'),
				last_name: getUserRec(registration.getValue('user')).getValue('last_name'),
				job_title: getUserRec(registration.getValue('user')).getValue('title'),
				officer_title: getUserRec(registration.getValue('user')).getValue('u_officer_title'),
				county: event.getDisplayValue('b3_county'),
				state: event.getDisplayValue('b3_state'),
				msa: msa,
				csa: csa,
				organization: event.getValue('guidestar_organization_payload') ? guidestar_org.organization_name : "",
				lmi: event.getDisplayValue("lmi_percentage"),
				lmi_person: "",
				type: 'Scheduled Event',
				board_member: registration.getValue("board_member") == 1 ? "Yes" : "No",
				bu_team: event.getDisplayValue("bu_team") || "",
				documents: b3_utils.getTestimonials(event.getUniqueValue()).length,
				category: event.category.getDisplayValue(),
				cra: event.community_development_cra.getDisplayValue(),
				validation_status: registration.getDisplayValue('hours_approval_state') || "",
				url: "/x_banun_b3_m2m_users_events.do?sys_id=" + registration.getUniqueValue(),
				hours : registration.getValue('hours_dec')? "" + registration.getValue('hours_dec') : 0,
				description: event.getValue('description') ? event.getValue('description').replace(/\n/g, '<br>') : ''
			});
		}
		return event_array;
	}

	function getIVAs(userQuery, fromQuery, toQuery){

		// get the scheduled events
		var registration = new GlideRecord('x_banun_b3_iva');
		
		if (userQuery)
			registration.addQuery('participant', 'IN', userQuery);
		if (fromQuery) 
			registration.addEncodedQuery('date' + fromQuery);
		if (toQuery)
			registration.addEncodedQuery('date' + toQuery);

		registration.orderByDesc('date');
		
		// Save for PDF export
		data.ivasQuery = registration.getEncodedQuery();
		
		registration.query();
		var iva_array = [];

		while (registration.next()) {
			var guidestar_org = "";
			if (registration.getValue('guidestar_organization_payload')) {
				try {
					guidestar_org = JSON.parse(registration.getValue('guidestar_organization_payload'));
				} catch(ex) {
					var link_to_record = '<a href="x_banun_b3_iva.do?sys_id=' + registration.sys_id + '" class="breadcrumb" target="_blank">' + registration.activity_name + '</a> ';
					gs.addErrorMessage(link_to_record + " record has been skipped due to a Jason parsing error. Verify that the 'guidestar_organization_payload' field of this record contains valid Json Syntax");
				}
				
			}
			var county = ""; var msa = ""; var csa = "";
			if (registration.getValue('b3_county')) {
				county = registration.b3_county.getRefRecord();
				if (county.msa) {
					msa = county.getDisplayValue('msa');
					if (county.msa.csa)
						csa = county.msa.getDisplayValue('csa');
				}
			}

			iva_array.push({
				sys_id: registration.getUniqueValue(),
				title: registration.getValue('activity_name') ? registration.getValue('activity_name') : "",
				date: registration.getDisplayValue('date') ? registration.getDisplayValue('date') : "",
				first_name: registration.getDisplayValue('participant') ? getUserRec(registration.getValue('participant')).getValue('first_name') : "",
				last_name: registration.getDisplayValue('participant') ? getUserRec(registration.getValue('participant')).getValue('last_name') : "",
				job_title: registration.getDisplayValue('participant') ? getUserRec(registration.getValue('participant')).getValue('title') : "",
				officer_title: registration.getDisplayValue('participant') ? getUserRec(registration.getValue('participant')).getValue('u_officer_title') : "",
				county: registration.getDisplayValue('b3_county'),
				state: registration.getDisplayValue('b3_state'),
				msa: msa,
				csa: csa,
				organization: registration.getValue('guidestar_organization_payload') ?  guidestar_org.organization_name : "",
				lmi: "",
				lmi_person: registration.getValue('activity_lmi_person') == 1 ? "Yes" : "No",
				type: 'IVA',
				board_member: registration.getValue("board_member") == 1 ? "Yes" : "No",
				bu_team: registration.getDisplayValue("bu_team") || "",
				documents: "",
				category: registration.category.getDisplayValue()? registration.category.getDisplayValue() : "",
				cra: registration.community_development_cra.getDisplayValue()? registration.community_development_cra.getDisplayValue() : "",
				validation_status: registration.approval_state.getDisplayValue()? registration.approval_state.getDisplayValue() : "",
				url: "/x_banun_b3_iva.do?sys_id=" + registration.getUniqueValue(),
				hours : registration.getValue('hours_dec')? "" + registration.getValue('hours_dec') : 0,
				description: registration.getValue('description') ? registration.getValue('description').replace(/\n/g, '<br>') : ''
			});
		}
		return iva_array;
	}


	/**
	*parm event_date: event date
	*parm iva_date: iva date
	*return boolean (event_date is greater thant iva_date)
	*/
	function event_greater(event_date, iva_date){
		var gdt_event = new GlideDateTime(event_date);
		var gdt_iva = new GlideDateTime(iva_date);
		return gdt_iva.after(gdt_event);
	}


	//Param is a string date of this format : 08-31-2020
	//Output is a string date of this format : 2020-08-31
	function convertDate(date){
		return date.substr(6,9) + '-' + date.substr(0,2) + date.substr(2,3);
	}
	
	function getUserRec(sys_id){
		var gr_user = new GlideRecord("sys_user");
		gr_user.get("sys_id", sys_id);
		return gr_user;
	}

})();










// Client Script

api.controller = function($scope, spUtil, $rootScope, $uibModal, spModal) {
	/* widget controller */
	var c = this;
	
	var dev_in_progress = false;

    if (dev_in_progress) {
        spUtil.recordWatch($scope, 'sp_widget', 'sys_id=' + c.options.sp_widget, function (name) {
            top.location.reload();
        });
    }
	
	// -- Initialize --
	
	// Choice list
	c.selectionOptions = {
		hideSearch: true
	};
	c.selectionItems = c.data.selectionItems;
	c.selectionChoice = c.data.selectionChoice;
	
	// -- Listeners --
	$scope.pagination = {
		currentPage: 1
	};

	$scope.items_per_page = 8;

	$scope.selectionChanged = function (selectedValue) {
		
		if (selectedValue == 'delegated_users')
			c.data.fieldUserQuery = "active=true^sys_idIN" + c.data.delegatedAccess;
		else
			c.data.fieldUserQuery = "active=true";
		
		c.selectionChoice = selectedValue;
		$scope.userSelected = {
			displayValue: "",
			value: "",
			name: 'userSelected'
		};
	};
	
	// Converts a date-string with any user's preferred date format into a Date object
	function convertStringToDate(inputDate, format) {
		var lowFormat = format.toLowerCase();

		// Retrieve date from format
		var year = inputDate.substring(lowFormat.indexOf('y'), lowFormat.indexOf('y') + 4);
		var month = inputDate.substring(lowFormat.indexOf('m'), lowFormat.indexOf('m') + 2);
		var day = inputDate.substring(lowFormat.indexOf('d'), lowFormat.indexOf('d') + 2);
		
		var outputDate = new Date();
		outputDate.setFullYear(year, month - 1, day);
		return outputDate;
	}
	
	$scope.filterEvents = function () {
		
		var from = '';
		var to = '';
		if (c.data.from != '' || c.data.to != '') {
			var invalid_dates = [];
		
			// Validate dates format
			var date_regex = /^\d{2,4}(.|-|\/)\d{2}\1\d{2,4}$/;

			if (c.data.from != '' && !c.data.from.match(date_regex)) {
				invalid_dates.push('From');
				c.data.from = "";
			}
			if (c.data.to != '' && !c.data.to.match(date_regex)) {
				invalid_dates.push('To');
				c.data.to = "";
			}

			if (invalid_dates.length != 0) {
				spUtil.addErrorMessage("Incorrect date format on the field(s): " + invalid_dates.join(', '));
				return;
			}

			// Convert string dates to date objects, corresponding to the user's prefered format
			if (c.data.from != '')
				from = convertStringToDate(c.data.from, g_user_date_format);
			if (c.data.to != '')
				to = convertStringToDate(c.data.to, g_user_date_format);

			// Validate that the date range is set in order
			if (from != '' && to != '') {
				if (from > to) {
					spUtil.addErrorMessage("The end date must be after the start date.");
					c.data.from = "", c.data.to = "";
					return;
				}
			}
			
			// Convert dates to a yyyy-mm-dd string
			if (from != '')
				from = from.toISOString().split('T')[0];
			if (to != '')
				to = to.toISOString().split('T')[0];
		}
		
		c.server.get({
			action: 'filterEvents',
			selectionChoice: c.selectionChoice,
			userSelected: $scope.userSelected,
			delegatedAccess: c.data.delegatedAccess,
			from: from,
			to: to
		}).then(function(r){
			c.data.submitted = r.data.submitted;
			c.data.events = r.data.events;
			c.data.sumEvents = r.data.sumEvents;
			c.data.sumHours = r.data.sumHours;
			
			c.data.eventsQuery = r.data.eventsQuery;
			c.data.ivasQuery = r.data.ivasQuery;
		});
	};

	$scope.rowClick = function(url){
		window.open(url, '_blank');
	};

	// Export excel file
	$scope.fnExcelReport = function(){
		var tab_text='<table border="2px" style="font-weight : bold;">';
		var textRange; var j=0;
		//tab = document.getElementById('headerTable'); // id of table
		if (c.data.eventManager){
