// HTML

<div class="b3-report">

  <a id="greet">Participation Report</a>
  <hr style="height:20px; width:45%; color:grey; background:linear-gradient(to right, lightgray, #a9a9a9); margin:0px;">

  <div class="top">
    <div>
      Below you will find all the hours you have accumulated during your lifetime at BankUnited.
      <strong style="text-decoration: underline; color:red;">Note that your hours must be submitted in order to appear on the report.</strong>
      Query by date and download your report.
    </div>
  </div>

  <div class="picker-container" ng-if="c.data.delegatedToMe || c.data.eventManager">
    <div class="picker-item">Selection</div>
    <div class="picker-item">
      <sn-choice-list sn-model="c.selectionChoice"
                      sn-items="c.selectionItems"
                      sn-value-field="choiceValue"
                      sn-text-field="choiceDisplay"
                      sn-options="c.selectionOptions"
                      sn-on-change="selectionChanged(selectedValue)"></sn-choice-list>
    </div>

    <div class="picker-item" ng-if="c.selectionChoice == 'delegated_users' || c.selectionChoice == 'users'">User</div>
    <div class="picker-item" ng-if="c.selectionChoice == 'delegated_users' || c.selectionChoice == 'users'">
      <sn-record-picker field="userSelected"
                        table="'sys_user'"
                        display-field="'name'"
                        value-field="'sys_id'"
                        search-fields="'user_name,name'"
                        page-size="100"
                        default-query="data.fieldUserQuery"></sn-record-picker>
    </div>
  </div>

  <div class="picker-container">
    <div class="picker-item">From</div>
    <div class="picker-item">
      <input type="date" class="date-input" ng-model="c.data.from" aria-label="From date">
    </div>
    <div class="picker-item">To</div>

    <div class="picker-item">
      <input type="date" class="date-input" ng-model="c.data.to" aria-label="To date">
    </div>

    <div>
      <button ng-click="filterEvents()" class="submit">Submit</button>
    </div>
  </div>

  <div ng-if="c.data.submitted">
    <div class="top" ng-if="c.data.sumEvents == 0">
      <div style="color:red">
        No volunteering records have been found. Participation Report is only available for users that submitted their hours.
      </div>
    </div>

    <div id="printableArea" ng-if="c.data.sumEvents != 0">
      <table style="width:600px" class="list-group" id="export_table">
        <tbody>
          <tr>
            <th class="tab_header">First Name</th>
            <th class="tab_header">Last Name</th>
            <th class="tab_header">Event Title</th>
            <th class="tab_header">Event Date</th>
            <th class="tab_header">Hours Volunteered</th>
            <th class="tab_header">Organization Name</th>
            <th class="tab_header">LMI%</th>
            <th class="tab_header">Board Member</th>
            <th class="tab_header">Volunteer Category</th>
            <th ng-if="c.data.eventManager" class="tab_header">BU Team</th>
            <th ng-if="c.data.eventManager" class="tab_header">CRA</th>
            <th class="tab_header">Type of Event</th>
            <th class="tab_header">CRA Approval Status</th>
          </tr>

          <tr class="tr_click" ng-repeat="item in c.data.events | limitTo:items_per_page:items_per_page*(pagination.currentPage-1)">
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.first_name}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.last_name}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.title}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.date}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.hours}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.organization}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.lmi}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.board_member}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.category}}</td>
            <td ng-if="c.data.eventManager" ng-click="rowClick(item.url)" class="tab_elem">{{item.bu_team}}</td>
            <td ng-if="c.data.eventManager" ng-click="rowClick(item.url)" class="tab_elem">{{item.cra}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.type}}</td>
            <td ng-click="rowClick(item.url)" class="tab_elem">{{item.validation_status}}</td>
          </tr>
        </tbody>
      </table>

      <table style="width:600px;" id="totals_table">
        <tbody>
          <tr>
            <th class="tab_header">Total Activities</th>
            <th class="tab_header">Total Hours</th>
          </tr>
          <tr>
            <td class="tab_elem">{{c.data.sumEvents}}</td>
            <td class="tab_elem">{{c.data.sumHours}}</td>
          </tr>
        </tbody>
      </table>

      <span class="ps-page">
        <uib-pagination class="pagination-sm pagination" max-size="8" total-items="c.data.events.length"
                        ng-model="pagination.currentPage" previous-text="&lsaquo;" next-text="&rsaquo;" items-per-page="items_per_page">
        </uib-pagination>
      </span>

      <br>

      <div id="export_buttons">
        <button class="btn btn-primary" ng-click="exportPDF()">Export to PDF</button>
        <button class="btn btn-primary" ng-click="fnExcelReport()" style="color:white;">Export to Excel</button>
      </div>
    </div>
  </div>
</div>








// CSS

.b3-report {
  margin-bottom: 50px;

  th { text-align: center; }

  #greet {
    color: black;
    font-weight: bold;
    font-size: 24px;
  }

  .top {
    color: black;
    display: grid;
    grid-template-columns: auto auto;
    padding: 20px 20px;
    box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2), 0 6px 20px 0 rgba(0,0,0,0.19);
    margin: 25px;
    margin-left: 0px;
    width: 600px;
  }

  .picker-container {
    width: 600px;
    display: grid;
    grid-template-columns: 90px 250px 40px 250px auto;
    padding-bottom: 20px;
  }

  .picker-item {
    color: black;
    font-weight: bold;
    padding: 10px;
    text-align: center;
    line-height: 2;
  }

  .picker-item-options {
    grid-column-start: 1;
    grid-column-end: 3;
  }

  .date-input {
    width: 100%;
    height: 34px;
    padding: 6px 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
    color: black;
    font-weight: normal;
    font-size: 14px;
