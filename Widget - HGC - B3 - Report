  }

  .submit:hover {
    background: linear-gradient(to right, #0088b5, #333dff, #6510b0);
  }

  .tab_header {
    color: white;
    line-height: 30px;
    font-weight: bold;
    background: black;
    border: 2px solid white;
    font-size: 17px;
    padding: 10px;
  }

  #export_table,
  #totals_table {
