  }

  .date-input::-webkit-calendar-picker-indicator:hover {
    filter: opacity(1);
  }

  .submit {
    background: linear-gradient(to right, #00AAE3, #3363FF, #7B12D4);
    width: 90px;
    font-size: 16px;
    color: white;
